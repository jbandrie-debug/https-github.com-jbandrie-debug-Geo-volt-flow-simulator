+      const pr2 = model.addComponent('resistor', { resistance: 20 }, { x: 200, y: 150 });
+      model.addWire(`${b3.id}_pos`, `${pr1.id}_t1`);
+      model.addWire(`${b3.id}_pos`, `${pr2.id}_t1`);
+      model.addWire(`${pr1.id}_t2`, `${b3.id}_neg`);
