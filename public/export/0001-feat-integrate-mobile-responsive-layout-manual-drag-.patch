+    } else {
+      handleDeleteComponent(id);
+    }
+  };
+
+  // Add wire
+  const handleAddWire = (fromTerminalId: string, toTerminalId: string) => {
+    const wire = model.addWire(fromTerminalId, toTerminalId);
