+/**
+ * @license
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import {
+  CircuitComponent,
+  ComponentProperties,
+  ComponentType,
+  SerializedCircuit,
+  SolverResult,
+  Terminal,
+  Wire,
+} from '../types/circuit';
+
+export class CircuitModel {
+  components: Map<string, CircuitComponent> = new Map();
+  wires: Wire[] = [];
+  nextId: number = 1;
+
+  clear() {
+    this.components.clear();
+    this.wires = [];
+    this.nextId = 1;
+  }
+
+  addComponent(
